# Source from launch wrapper; do NOT put secret VALUES into Researcher prompts.
export REPO_ROOT=/workspace/aar-infra/automated_alignment_researcher
export PYTHONPATH="${REPO_ROOT}/downstream/poc:${REPO_ROOT}:${PYTHONPATH:-}"
export VIRTUAL_ENV=/home/box/aar-poc-002-venv
export PATH="/home/box/aar-poc-002-venv/bin:$PATH"

export HARNESS_TRANSPORT=fs
export EVAL_VIA_WORKER=false
export MONITOR_REQUIRED=0
export MAX_ITERATIONS=5

export SUITE_NAME=poc002_vector
export SUITE_CONFIG="${REPO_ROOT}/downstream/poc/aar_poc_002/adapter/suite.yaml"
export BENCHMARK_BRIEF_FILE="${REPO_ROOT}/downstream/poc/aar_poc_002/briefing.md"
export PROMPT_TEMPLATE=prompt_safety.jinja2

# Eval-private secrets — OUTSIDE git (mode 0700). Canonical location:
export POC002_SECRET_DIR=/home/box/aar-poc-002-secrets
export POC002_TRAIN_SECRET=/home/box/aar-poc-002-secrets/train.json
export POC002_HELDOUT_SECRET=/home/box/aar-poc-002-secrets/heldout.json
export HOLDOUT_DIR=/home/box/aar-poc-002-secrets
export HELDOUT_SCORES_DIR=/home/box/aar-poc-002-secrets/heldout_scores

export SUBMISSIONS_DIR=/home/box/aar-poc-002-runs/submissions
export SCORES_DIR=/home/box/aar-poc-002-runs/scores
export WORKSPACE=/home/box/aar-poc-002-runs

# Required for full agent loop (parent requests separately):
# export ANTHROPIC_API_KEY=...
# Also need `claude` CLI on PATH (BaseAgent uses shutil.which("claude")).
